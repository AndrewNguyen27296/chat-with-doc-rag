# Copy to .env and fill in. .env is gitignored.

# Needed for V1 (answer generation). V0 ingestion/retrieval runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ---
# Embedding model. Runs locally; nothing is sent anywhere to embed.
EMBEDDING_MODEL=all-MiniLM-L6-v2
# How it runs: "onnx" (default, torch-free, what deploys) or
# "sentence-transformers" (install it yourself; pulls torch).
EMBEDDING_BACKEND=onnx
# Where the local Chroma database is persisted.
CHROMA_DIR=.chroma
# Collection name inside Chroma.
COLLECTION_NAME=company_docs
# Retrieval depth.
TOP_K=3

# --- V1 (answer generation) ---
# Model that writes the grounded answer. Bump this to a newer Sonnet freely.
ANSWER_MODEL=claude-sonnet-5
MAX_ANSWER_TOKENS=600
# Pre-model refusal gate. 0.37 is the floor scripts/verify_v0.py suggested on
# 2026-09-14 from the real embedding model (in-scope >= 0.539, off-topic <= 0.204).
SIMILARITY_FLOOR=0.37

# --- Provider selection ---
# "auto" (prefer whichever key is present, free tier first) | "gemini" | "anthropic"
LLM_PROVIDER=auto
# Gemini's free tier costs nothing and needs no card. Google states free-tier
# content may be used to improve their products — fine for the synthetic sample
# handbooks, NOT for a client's real documents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# gemini-3.5-flash-lite for higher free-tier throughput, gemini-3.8-flash for
# the best answers.

# --- Spend guard ---
# Model answers per browser session before the app degrades to retrieval-only.
# 0 disables the cap. A public URL carries your key; leave this on.
MAX_QUESTIONS_PER_SESSION=20
